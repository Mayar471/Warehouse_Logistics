# Local demonstration only. No live SMS, email, payment, or Tendsy connection.
APP_MODE=demo
HOST=127.0.0.1
PORT=3001
DATA_DIR=.local/postgres
# Vite build-time map settings; never place private API keys in VITE_* variables.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional additional provider attribution. OSM credit is always shown.
VITE_MAP_ATTRIBUTION=

# Private hosted presentation (Render + Neon), separate from local demo above.
# Set these through the host's secret environment settings; never commit real values.
# APP_MODE=hosted-demo
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
# PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
# APPLICATION_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# WEBHOOK_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# DEMO_ACCESS_PASSWORD=GENERATE_AT_LEAST_20_RANDOM_CHARACTERS
# NODE_OPTIONS=--max-old-space-size=256
# SERVE_WEB=true
