{
  "name": "logistics-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write server web shared scripts tests vite.config.ts package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check server web shared scripts tests vite.config.ts package.json tsconfig.json .prettierrc.json",
    "test": "node --no-wasm-tier-up --no-wasm-code-gc --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "tsx server/main.ts",
    "demo": "tsx scripts/preview.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "fastify": "^5.12.5",
    "h3-js": "4.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
